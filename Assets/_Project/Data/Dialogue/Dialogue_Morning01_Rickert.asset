  m_Name: Dialogue_Morning01_Rickert
  m_EditorClassIdentifier: Assembly-CSharp::Branded.Dialogue.DialogueData
  speakerName: Rickert
  speakerPortrait: {fileID: 21300000, guid: 3c1fa89ce546cc7409891958ae65985b, type: 3}
  voiceMumble: {fileID: 0}
  lines:
  - "Guts! Geceyi atlatm\u0131\u015Fs\u0131n... M\xFCh\xFCr h\xE2l\xE2 kan\u0131yor mu?"
  - "Ate\u015Fi ben harlar\u0131m, sen biraz nefeslen. Karanl\u0131k \xE7\xF6k\xFCnce yine gelecekler."
  - "Yan\u0131mda birka\xE7 \u015Fey var. Birini al, i\u015Fine yarar."
