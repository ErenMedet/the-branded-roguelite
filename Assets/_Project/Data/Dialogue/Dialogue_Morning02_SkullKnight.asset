  m_Script: {fileID: 11500000, guid: 44a3351ee852c3d4ebfaaff5c9d84cca, type: 3}
  m_Name: Dialogue_Morning02_SkullKnight
  m_EditorClassIdentifier: Assembly-CSharp::Branded.Dialogue.DialogueData
  speakerName: "Kafatas\u0131 \u015E\xF6valyesi"
  speakerPortrait: {fileID: 21300000, guid: fb90b84fa33fa144594ab77527ac0585, type: 3}
  voiceMumble: {fileID: 0}
  lines:
  - "Damgal\u0131 Sava\u015F\xE7\u0131... Karanl\u0131\u011F\u0131n i\xE7inden bir kez daha y\xFCr\xFCd\xFCn."
  - "Ama bu gecenin sonunda seni bekleyen, \u015Fimdiye dek g\xF6rd\xFCklerine benzemez."
  - "Se\xE7imini yap. Nedensellik ak\u0131\u015F\u0131, iradeni s\u0131nayacak."
